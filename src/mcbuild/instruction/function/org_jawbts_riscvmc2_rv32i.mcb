function i_lw {
	scoreboard players set #imm_rs1_lw org_jawbts_riscvmc2_register $(imm)
	scoreboard players operation #imm_rs1_lw org_jawbts_riscvmc2_register += #$(rs1) org_jawbts_riscvmc2_register
	template load_word #imm_rs1_lw@org_jawbts_riscvmc2_register #$(rd)@org_jawbts_riscvmc2_register
	template _pc_add 4
}

