import ./org_jawbts_riscvmc2_rv32m_t.mcbt

function onload org_jawbts_riscvmc2:load {
    scoreboard objectives add org_jawbts_riscvmc2_rv32m_temp dummy
    scoreboard objectives add org_jawbts_riscvmc2_rv32m_consts dummy

    scoreboard players set #min_int org_jawbts_riscvmc2_rv32m_consts -2147483648
    scoreboard players set #base org_jawbts_riscvmc2_rv32m_consts 65536
    scoreboard players set #one org_jawbts_riscvmc2_rv32m_consts 1
}

