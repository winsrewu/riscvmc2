import ./org_jawbts_riscvmc2_rv32i_t.mcbt

# Some parameters in this namespace is in this format:
# <player name>@<scoreboard name>

template _udiv16 {
    with input:word output:word {
        scoreboard players operation #r org_jawbts_riscvmc2_rv32m_temp = <% input.replace("@", " ") %>
        scoreboard players operation #r org_jawbts_riscvmc2_rv32m_temp %= #base org_jawbts_riscvmc2_rv32m_consts
        execute if score #r org_jawbts_riscvmc2_rv32m_temp matches ..-1 run {
            scoreboard players operation #r org_jawbts_riscvmc2_rv32m_temp += #base org_jawbts_riscvmc2_rv32m_consts
        }
        scoreboard players operation <% output.replace("@", " ") %> = <% input.replace("@", " ") %>
        scoreboard players operation <% output.replace("@", " ") %> -= #r org_jawbts_riscvmc2_rv32m_temp
        scoreboard players operation <% output.replace("@", " ") %> /= #base org_jawbts_riscvmc2_rv32m_consts

        scoreboard players set #oa org_jawbts_riscvmc2_rv32m_temp 0
        execute if score <% output.replace("@", " ") %> matches ..-1 run {
            scoreboard players set #oa org_jawbts_riscvmc2_rv32m_temp 65536
        }
        scoreboard players operation <% output.replace("@", " ") %> += #oa org_jawbts_riscvmc2_rv32m_temp
    }
}

template _umod16 {
    with input:word output:word {
        scoreboard players operation <% output.replace("@", " ") %> = <% input.replace("@", " ") %>
        scoreboard players operation <% output.replace("@", " ") %> %= #base org_jawbts_riscvmc2_rv32m_consts
        scoreboard players set #oa org_jawbts_riscvmc2_rv32m_temp 0
        execute if score <% output.replace("@", " ") %> matches ..-1 run {
            scoreboard players set #oa org_jawbts_riscvmc2_rv32m_temp 65536
        }
        scoreboard players operation <% output.replace("@", " ") %> += #oa org_jawbts_riscvmc2_rv32m_temp
    }
}

