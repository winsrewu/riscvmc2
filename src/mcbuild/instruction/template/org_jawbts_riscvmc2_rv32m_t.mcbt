import ./org_jawbts_riscvmc2_rv32i_t.mcbt

# Some parameters in this namespace is in this format:
# <player name>@<scoreboard name>

template _udiv16 {
    with input:word output:word {
        scoreboard players operation #r org_jawbts_riscvmc2_rv32m_temp = <% input.replace("@", " ") %>
        scoreboard players operation #r org_jawbts_riscvmc2_rv32m_temp %= #base org_jawbts_riscvmc2_rv32m_consts
        execute if score #r org_jawbts_riscvmc2_rv32m_temp matches ..-1 run {
            scoreboard players operation #r org_jawbts_riscvmc2_rv32m_temp += #base org_jawbts_riscvmc2_rv32m_consts
        }
        scoreboard players operation <% output.replace("@", " ") %> = <% input.replace("@", " ") %>
        scoreboard players operation <% output.replace("@", " ") %> -= #r org_jawbts_riscvmc2_rv32m_temp
        scoreboard players operation <% output.replace("@", " ") %> /= #base org_jawbts_riscvmc2_rv32m_consts

        scoreboard players set #oa org_jawbts_riscvmc2_rv32m_temp 0
        execute if score <% output.replace("@", " ") %> matches ..-1 run {
            scoreboard players set #oa org_jawbts_riscvmc2_rv32m_temp 65536
        }
        scoreboard players operation <% output.replace("@", " ") %> += #oa org_jawbts_riscvmc2_rv32m_temp
    }
}

template _umod16 {
    with input:word output:word {
        scoreboard players operation <% output.replace("@", " ") %> = <% input.replace("@", " ") %>
        scoreboard players operation <% output.replace("@", " ") %> %= #base org_jawbts_riscvmc2_rv32m_consts
        scoreboard players set #oa org_jawbts_riscvmc2_rv32m_temp 0
        execute if score <% output.replace("@", " ") %> matches ..-1 run {
            scoreboard players set #oa org_jawbts_riscvmc2_rv32m_temp 65536
        }
        scoreboard players operation <% output.replace("@", " ") %> += #oa org_jawbts_riscvmc2_rv32m_temp
    }
}

template _mul_high {
    with input_a:word input_b:word a_signed:word b_signed:word output:word {
        template _udiv16 <% input_a %> #ah@org_jawbts_riscvmc2_rv32m_temp
        template _umod16 <% input_a %> #al@org_jawbts_riscvmc2_rv32m_temp
        template _udiv16 <% input_b %> #bh@org_jawbts_riscvmc2_rv32m_temp
        template _umod16 <% input_b %> #bl@org_jawbts_riscvmc2_rv32m_temp

        scoreboard players operation #p0 org_jawbts_riscvmc2_rv32m_temp = #al org_jawbts_riscvmc2_rv32m_temp
        scoreboard players operation #p0 org_jawbts_riscvmc2_rv32m_temp *= #bl org_jawbts_riscvmc2_rv32m_temp
        template _udiv16 #p0@org_jawbts_riscvmc2_rv32m_temp #c0@org_jawbts_riscvmc2_rv32m_temp

        scoreboard players operation #t1 org_jawbts_riscvmc2_rv32m_temp = #ah org_jawbts_riscvmc2_rv32m_temp
        scoreboard players operation #t1 org_jawbts_riscvmc2_rv32m_temp *= #bl org_jawbts_riscvmc2_rv32m_temp
        template _umod16 #t1@org_jawbts_riscvmc2_rv32m_temp #t1_lo@org_jawbts_riscvmc2_rv32m_temp
        template _udiv16 #t1@org_jawbts_riscvmc2_rv32m_temp #t1_hi@org_jawbts_riscvmc2_rv32m_temp

        scoreboard players operation #t2 org_jawbts_riscvmc2_rv32m_temp = #al org_jawbts_riscvmc2_rv32m_temp
        scoreboard players operation #t2 org_jawbts_riscvmc2_rv32m_temp *= #bh org_jawbts_riscvmc2_rv32m_temp
        template _umod16 #t2@org_jawbts_riscvmc2_rv32m_temp #t2_lo@org_jawbts_riscvmc2_rv32m_temp
        template _udiv16 #t2@org_jawbts_riscvmc2_rv32m_temp #t2_hi@org_jawbts_riscvmc2_rv32m_temp

        scoreboard players operation #sum_mid org_jawbts_riscvmc2_rv32m_temp = #c0 org_jawbts_riscvmc2_rv32m_temp
        scoreboard players operation #sum_mid org_jawbts_riscvmc2_rv32m_temp += #t1_lo org_jawbts_riscvmc2_rv32m_temp
        scoreboard players operation #sum_mid org_jawbts_riscvmc2_rv32m_temp += #t2_lo org_jawbts_riscvmc2_rv32m_temp
        scoreboard players operation #carry org_jawbts_riscvmc2_rv32m_temp = #sum_mid org_jawbts_riscvmc2_rv32m_temp
        scoreboard players operation #carry org_jawbts_riscvmc2_rv32m_temp /= #base org_jawbts_riscvmc2_rv32m_consts

        scoreboard players operation <% output.replace("@", " ") %> = #ah org_jawbts_riscvmc2_rv32m_temp
        scoreboard players operation <% output.replace("@", " ") %> *= #bh org_jawbts_riscvmc2_rv32m_temp
        scoreboard players operation <% output.replace("@", " ") %> += #t1_hi org_jawbts_riscvmc2_rv32m_temp
        scoreboard players operation <% output.replace("@", " ") %> += #t2_hi org_jawbts_riscvmc2_rv32m_temp
        scoreboard players operation <% output.replace("@", " ") %> += #carry org_jawbts_riscvmc2_rv32m_temp

        IF a_signed == "signed" {
            execute if score <% input_a.replace("@", " ") %> matches ..-1 run scoreboard players operation <% output.replace("@", " ") %> -= <% input_b.replace("@", " ") %>
        }
        IF b_signed == "signed" {
            execute if score <% input_b.replace("@", " ") %> matches ..-1 run scoreboard players operation <% output.replace("@", " ") %> -= <% input_a.replace("@", " ") %>
        }
    }
}

template _divu {
    with input_a:word input_b:word output:word {
        scoreboard players operation #a org_jawbts_riscvmc2_rv32m_temp = <% input_a.replace("@", " ") %>
        scoreboard players operation #b org_jawbts_riscvmc2_rv32m_temp = <% input_b.replace("@", " ") %>

        execute if score #b org_jawbts_riscvmc2_rv32m_temp matches 0 run {
            scoreboard players set #d org_jawbts_riscvmc2_rv32m_temp -1
        } else if score #b org_jawbts_riscvmc2_rv32m_temp matches 1 run {
            scoreboard players operation #d org_jawbts_riscvmc2_rv32m_temp = #a org_jawbts_riscvmc2_rv32m_temp
        } else if score #a org_jawbts_riscvmc2_rv32m_temp matches 0.. if score #b org_jawbts_riscvmc2_rv32m_temp matches 1.. run {
            scoreboard players operation #d org_jawbts_riscvmc2_rv32m_temp = #a org_jawbts_riscvmc2_rv32m_temp
            scoreboard players operation #d org_jawbts_riscvmc2_rv32m_temp /= #b org_jawbts_riscvmc2_rv32m_temp
        } else if score #a org_jawbts_riscvmc2_rv32m_temp matches 0.. run {
            scoreboard players set #d org_jawbts_riscvmc2_rv32m_temp 0
        } else if score #b org_jawbts_riscvmc2_rv32m_temp matches 1.. run {
            # MC /= and %= floor toward -inf (verified on the real game),
            # so derive the unsigned quotient from floor values:
            #   a_u = 2^31 + l,  l = a - min_int in [0, 2^31)
            #   q31  = min_int / b       = -(q31t + c), c = (2^31 % b != 0)
            #   q31f = min_int % b       = c ? b - (2^31 % b) : 0
            #   d = q31t + l/b + carry, carry = (c && rl >= q31f)
            scoreboard players operation #q31 org_jawbts_riscvmc2_rv32m_temp = #min_int org_jawbts_riscvmc2_rv32m_consts
            scoreboard players operation #q31 org_jawbts_riscvmc2_rv32m_temp /= #b org_jawbts_riscvmc2_rv32m_temp
            scoreboard players operation #q31f org_jawbts_riscvmc2_rv32m_temp = #min_int org_jawbts_riscvmc2_rv32m_consts
            scoreboard players operation #q31f org_jawbts_riscvmc2_rv32m_temp %= #b org_jawbts_riscvmc2_rv32m_temp

            scoreboard players operation #l org_jawbts_riscvmc2_rv32m_temp = #a org_jawbts_riscvmc2_rv32m_temp
            scoreboard players operation #l org_jawbts_riscvmc2_rv32m_temp -= #min_int org_jawbts_riscvmc2_rv32m_consts

            scoreboard players operation #ql org_jawbts_riscvmc2_rv32m_temp = #l org_jawbts_riscvmc2_rv32m_temp
            scoreboard players operation #ql org_jawbts_riscvmc2_rv32m_temp /= #b org_jawbts_riscvmc2_rv32m_temp

            scoreboard players operation #rl org_jawbts_riscvmc2_rv32m_temp = #l org_jawbts_riscvmc2_rv32m_temp
            scoreboard players operation #rl org_jawbts_riscvmc2_rv32m_temp %= #b org_jawbts_riscvmc2_rv32m_temp

            scoreboard players set #_neg org_jawbts_riscvmc2_rv32m_temp 0
            scoreboard players operation #_neg org_jawbts_riscvmc2_rv32m_temp -= #q31 org_jawbts_riscvmc2_rv32m_temp

            execute if score #q31f org_jawbts_riscvmc2_rv32m_temp matches 1.. run scoreboard players operation #_neg org_jawbts_riscvmc2_rv32m_temp -= #one org_jawbts_riscvmc2_rv32m_consts
            execute if score #q31f org_jawbts_riscvmc2_rv32m_temp matches 1.. if score #rl org_jawbts_riscvmc2_rv32m_temp >= #q31f org_jawbts_riscvmc2_rv32m_temp run scoreboard players operation #_neg org_jawbts_riscvmc2_rv32m_temp += #one org_jawbts_riscvmc2_rv32m_consts

            scoreboard players operation #d org_jawbts_riscvmc2_rv32m_temp = #_neg org_jawbts_riscvmc2_rv32m_temp
            scoreboard players operation #d org_jawbts_riscvmc2_rv32m_temp += #ql org_jawbts_riscvmc2_rv32m_temp
        } else if score #a org_jawbts_riscvmc2_rv32m_temp >= #b org_jawbts_riscvmc2_rv32m_temp run {
            scoreboard players set #d org_jawbts_riscvmc2_rv32m_temp 1
        } else run {
            scoreboard players set #d org_jawbts_riscvmc2_rv32m_temp 0
        }

        scoreboard players operation <% output.replace("@", " ") %> = #d org_jawbts_riscvmc2_rv32m_temp
    }
}

template i_mul {
    with rs1:word rs2:word rd:word {
        scoreboard players operation #t org_jawbts_riscvmc2_rv32m_temp = #<% rs1 %> org_jawbts_riscvmc2_register
        scoreboard players operation #t org_jawbts_riscvmc2_rv32m_temp *= #<% rs2 %> org_jawbts_riscvmc2_register
        scoreboard players operation #<% rd %> org_jawbts_riscvmc2_register = #t org_jawbts_riscvmc2_rv32m_temp

        template _pc_add 4
    }
}

template i_mulh {
    with rs1:word rs2:word rd:word {
        template _mul_high <% "#" + rs1 + "@org_jawbts_riscvmc2_register" %> <% "#" + rs2 + "@org_jawbts_riscvmc2_register" %> signed signed <% "#" + rd + "@org_jawbts_riscvmc2_register" %>

        template _pc_add 4
    }
}

template i_mulhsu {
    with rs1:word rs2:word rd:word {
        template _mul_high <% "#" + rs1 + "@org_jawbts_riscvmc2_register" %> <% "#" + rs2 + "@org_jawbts_riscvmc2_register" %> signed unsigned <% "#" + rd + "@org_jawbts_riscvmc2_register" %>

        template _pc_add 4
    }
}

template i_mulhu {
    with rs1:word rs2:word rd:word {
        template _mul_high <% "#" + rs1 + "@org_jawbts_riscvmc2_register" %> <% "#" + rs2 + "@org_jawbts_riscvmc2_register" %> unsigned unsigned <% "#" + rd + "@org_jawbts_riscvmc2_register" %>

        template _pc_add 4
    }
}

template i_div {
    with rs1:word rs2:word rd:word {
        # MC /= floors toward -inf; RISC-V div truncates toward zero.
        # Fix up: opposite signs and a non-zero remainder -> add 1.
        scoreboard players set #div_flag org_jawbts_riscvmc2_rv32m_temp 0
        execute if score #<% rs2 %> org_jawbts_riscvmc2_register matches 0 run scoreboard players set #div_flag org_jawbts_riscvmc2_rv32m_temp 1
        execute if score #<% rs1 %> org_jawbts_riscvmc2_register matches -2147483648 if score #<% rs2 %> org_jawbts_riscvmc2_register matches -1 run scoreboard players set #div_flag org_jawbts_riscvmc2_rv32m_temp 2
        execute if score #div_flag org_jawbts_riscvmc2_rv32m_temp matches 0 run scoreboard players operation #d org_jawbts_riscvmc2_rv32m_temp = #<% rs1 %> org_jawbts_riscvmc2_register
        execute if score #div_flag org_jawbts_riscvmc2_rv32m_temp matches 0 run scoreboard players operation #d org_jawbts_riscvmc2_rv32m_temp /= #<% rs2 %> org_jawbts_riscvmc2_register
        execute if score #div_flag org_jawbts_riscvmc2_rv32m_temp matches 0 run scoreboard players operation #div_rem org_jawbts_riscvmc2_rv32m_temp = #<% rs1 %> org_jawbts_riscvmc2_register
        execute if score #div_flag org_jawbts_riscvmc2_rv32m_temp matches 0 run scoreboard players operation #div_rem org_jawbts_riscvmc2_rv32m_temp %= #<% rs2 %> org_jawbts_riscvmc2_register
        execute if score #div_flag org_jawbts_riscvmc2_rv32m_temp matches 1 run scoreboard players set #d org_jawbts_riscvmc2_rv32m_temp -1
        execute if score #div_flag org_jawbts_riscvmc2_rv32m_temp matches 2 run scoreboard players set #d org_jawbts_riscvmc2_rv32m_temp -2147483648
        execute if score #div_flag org_jawbts_riscvmc2_rv32m_temp matches 0 if score #<% rs1 %> org_jawbts_riscvmc2_register matches ..-1 if score #<% rs2 %> org_jawbts_riscvmc2_register matches 1.. unless score #div_rem org_jawbts_riscvmc2_rv32m_temp matches 0 run scoreboard players operation #d org_jawbts_riscvmc2_rv32m_temp += #one org_jawbts_riscvmc2_rv32m_consts
        execute if score #div_flag org_jawbts_riscvmc2_rv32m_temp matches 0 if score #<% rs1 %> org_jawbts_riscvmc2_register matches 1.. if score #<% rs2 %> org_jawbts_riscvmc2_register matches ..-1 unless score #div_rem org_jawbts_riscvmc2_rv32m_temp matches 0 run scoreboard players operation #d org_jawbts_riscvmc2_rv32m_temp += #one org_jawbts_riscvmc2_rv32m_consts
        scoreboard players operation #<% rd %> org_jawbts_riscvmc2_register = #d org_jawbts_riscvmc2_rv32m_temp
        template _pc_add 4
    }
}

template i_rem {
    with rs1:word rs2:word rd:word {
        # MC %= is floorMod; RISC-V rem keeps the sign of the dividend.
        # Fix up: dividend negative, divisor positive, non-zero rem -> -= b.
        scoreboard players set #rem_flag org_jawbts_riscvmc2_rv32m_temp 0
        execute if score #<% rs2 %> org_jawbts_riscvmc2_register matches 0 run scoreboard players set #rem_flag org_jawbts_riscvmc2_rv32m_temp 1
        execute if score #<% rs1 %> org_jawbts_riscvmc2_register matches -2147483648 if score #<% rs2 %> org_jawbts_riscvmc2_register matches -1 run scoreboard players set #rem_flag org_jawbts_riscvmc2_rv32m_temp 2
        execute if score #rem_flag org_jawbts_riscvmc2_rv32m_temp matches 1 run scoreboard players operation #d org_jawbts_riscvmc2_rv32m_temp = #<% rs1 %> org_jawbts_riscvmc2_register
        execute if score #rem_flag org_jawbts_riscvmc2_rv32m_temp matches 2 run scoreboard players set #d org_jawbts_riscvmc2_rv32m_temp 0
        execute if score #rem_flag org_jawbts_riscvmc2_rv32m_temp matches 0 run scoreboard players operation #d org_jawbts_riscvmc2_rv32m_temp = #<% rs1 %> org_jawbts_riscvmc2_register
        execute if score #rem_flag org_jawbts_riscvmc2_rv32m_temp matches 0 run scoreboard players operation #d org_jawbts_riscvmc2_rv32m_temp %= #<% rs2 %> org_jawbts_riscvmc2_register
        execute if score #rem_flag org_jawbts_riscvmc2_rv32m_temp matches 0 if score #<% rs1 %> org_jawbts_riscvmc2_register matches ..-1 if score #<% rs2 %> org_jawbts_riscvmc2_register matches 1.. unless score #d org_jawbts_riscvmc2_rv32m_temp matches 0 run scoreboard players operation #d org_jawbts_riscvmc2_rv32m_temp -= #<% rs2 %> org_jawbts_riscvmc2_register
        execute if score #rem_flag org_jawbts_riscvmc2_rv32m_temp matches 0 if score #<% rs1 %> org_jawbts_riscvmc2_register matches 1.. if score #<% rs2 %> org_jawbts_riscvmc2_register matches ..-1 unless score #d org_jawbts_riscvmc2_rv32m_temp matches 0 run scoreboard players operation #d org_jawbts_riscvmc2_rv32m_temp -= #<% rs2 %> org_jawbts_riscvmc2_register
        scoreboard players operation #<% rd %> org_jawbts_riscvmc2_register = #d org_jawbts_riscvmc2_rv32m_temp

        template _pc_add 4
    }
}

template i_divu {
    with rs1:word rs2:word rd:word {
        template _divu <% "#" + rs1 + "@org_jawbts_riscvmc2_register" %> <% "#" + rs2 + "@org_jawbts_riscvmc2_register" %> <% "#" + rd + "@org_jawbts_riscvmc2_register" %>

        template _pc_add 4
    }
}

template i_remu {
    with rs1:word rs2:word rd:word {
        scoreboard players operation #c1 org_jawbts_riscvmc2_rv32m_temp = #<% rs1 %> org_jawbts_riscvmc2_register
        scoreboard players operation #c2 org_jawbts_riscvmc2_rv32m_temp = #<% rs2 %> org_jawbts_riscvmc2_register
        template _divu #c1@org_jawbts_riscvmc2_rv32m_temp #c2@org_jawbts_riscvmc2_rv32m_temp #dr2@org_jawbts_riscvmc2_rv32m_temp
        scoreboard players operation #dr2 org_jawbts_riscvmc2_rv32m_temp *= #c2 org_jawbts_riscvmc2_rv32m_temp
        scoreboard players operation #dr org_jawbts_riscvmc2_rv32m_temp = #c1 org_jawbts_riscvmc2_rv32m_temp
        scoreboard players operation #dr org_jawbts_riscvmc2_rv32m_temp -= #dr2 org_jawbts_riscvmc2_rv32m_temp
        scoreboard players operation #<% rd %> org_jawbts_riscvmc2_register = #dr org_jawbts_riscvmc2_rv32m_temp

        template _pc_add 4
    }
}