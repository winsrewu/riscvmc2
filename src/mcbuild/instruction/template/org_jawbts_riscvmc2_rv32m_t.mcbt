template _divu {
    with input_a:word input_b:word output:word {
        scoreboard players operation #a org_jawbts_riscvmc2_rv32m_temp = <% input_a.replace("@", " ") %>
        scoreboard players operation #b org_jawbts_riscvmc2_rv32m_temp = <% input_b.replace("@", " ") %>

        execute if score #b org_jawbts_riscvmc2_rv32m_temp matches 0 run {
            scoreboard players set #d org_jawbts_riscvmc2_rv32m_temp -1
        } else if score #b org_jawbts_riscvmc2_rv32m_temp matches 1 run {
            scoreboard players operation #d org_jawbts_riscvmc2_rv32m_temp = #a org_jawbts_riscvmc2_rv32m_temp
        } else if score #a org_jawbts_riscvmc2_rv32m_temp matches 0.. if score #b org_jawbts_riscvmc2_rv32m_temp matches 1.. run {
            scoreboard players operation #d org_jawbts_riscvmc2_rv32m_temp = #a org_jawbts_riscvmc2_rv32m_temp
            scoreboard players operation #d org_jawbts_riscvmc2_rv32m_temp /= #b org_jawbts_riscvmc2_rv32m_temp
        } else if score #a org_jawbts_riscvmc2_rv32m_temp matches 0.. run {
            scoreboard players set #d org_jawbts_riscvmc2_rv32m_temp 0
        } else if score #b org_jawbts_riscvmc2_rv32m_temp matches 1.. run {
            scoreboard players operation #x org_jawbts_riscvmc2_rv32m_temp = #a org_jawbts_riscvmc2_rv32m_temp
            scoreboard players operation #x org_jawbts_riscvmc2_rv32m_temp /= #b org_jawbts_riscvmc2_rv32m_temp
            
            scoreboard players operation #y org_jawbts_riscvmc2_rv32m_temp = #a org_jawbts_riscvmc2_rv32m_temp
            scoreboard players operation #y org_jawbts_riscvmc2_rv32m_temp %= #b org_jawbts_riscvmc2_rv32m_temp
            
            scoreboard players operation #q31 org_jawbts_riscvmc2_rv32m_temp = #min_int org_jawbts_riscvmc2_rv32m_consts
            scoreboard players operation #q31 org_jawbts_riscvmc2_rv32m_temp /= #b org_jawbts_riscvmc2_rv32m_temp
            scoreboard players set #_neg org_jawbts_riscvmc2_rv32m_temp 0
            scoreboard players operation #_neg org_jawbts_riscvmc2_rv32m_temp -= #q31 org_jawbts_riscvmc2_rv32m_temp
            scoreboard players operation #q31 org_jawbts_riscvmc2_rv32m_temp = #_neg org_jawbts_riscvmc2_rv32m_temp

            scoreboard players operation #q31f org_jawbts_riscvmc2_rv32m_temp = #min_int org_jawbts_riscvmc2_rv32m_consts
            scoreboard players operation #q31f org_jawbts_riscvmc2_rv32m_temp %= #b org_jawbts_riscvmc2_rv32m_temp
            
            execute unless score #q31f org_jawbts_riscvmc2_rv32m_temp matches 0 run {
                scoreboard players operation #q31 org_jawbts_riscvmc2_rv32m_temp -= #one org_jawbts_riscvmc2_rv32m_consts
            }

            scoreboard players operation #rem31 org_jawbts_riscvmc2_rv32m_temp = #min_int org_jawbts_riscvmc2_rv32m_consts
            scoreboard players operation #rem31 org_jawbts_riscvmc2_rv32m_temp %= #b org_jawbts_riscvmc2_rv32m_temp

            scoreboard players operation #l org_jawbts_riscvmc2_rv32m_temp = #a org_jawbts_riscvmc2_rv32m_temp
            scoreboard players operation #l org_jawbts_riscvmc2_rv32m_temp -= #min_int org_jawbts_riscvmc2_rv32m_consts

            scoreboard players operation #ql org_jawbts_riscvmc2_rv32m_temp = #l org_jawbts_riscvmc2_rv32m_temp
            scoreboard players operation #ql org_jawbts_riscvmc2_rv32m_temp /= #b org_jawbts_riscvmc2_rv32m_temp

            scoreboard players operation #rl org_jawbts_riscvmc2_rv32m_temp = #l org_jawbts_riscvmc2_rv32m_temp
            scoreboard players operation #rl org_jawbts_riscvmc2_rv32m_temp %= #b org_jawbts_riscvmc2_rv32m_temp

            execute if score #rl org_jawbts_riscvmc2_rv32m_temp >= #q31f org_jawbts_riscvmc2_rv32m_temp run {
                scoreboard players operation #q31 org_jawbts_riscvmc2_rv32m_temp += #one org_jawbts_riscvmc2_rv32m_consts
            }

            scoreboard players operation #d org_jawbts_riscvmc2_rv32m_temp = #q31 org_jawbts_riscvmc2_rv32m_temp
            scoreboard players operation #d org_jawbts_riscvmc2_rv32m_temp += #ql org_jawbts_riscvmc2_rv32m_temp
        } else if score #a org_jawbts_riscvmc2_rv32m_temp >= #b org_jawbts_riscvmc2_rv32m_temp run {
            scoreboard players set #d org_jawbts_riscvmc2_rv32m_temp 1
        } else run {
            scoreboard players set #d org_jawbts_riscvmc2_rv32m_temp 0
        }

        scoreboard players operation <% output.replace("@", " ") %> = #d org_jawbts_riscvmc2_rv32m_temp
    }
}

template i_mul {
    with rs1:word rs2:word rd:word {
        scoreboard players operation #t org_jawbts_riscvmc2_rv32m_temp = #<% rs1 %> org_jawbts_riscvmc2_register
        scoreboard players operation #t org_jawbts_riscvmc2_rv32m_temp *= #<% rs2 %> org_jawbts_riscvmc2_register
        scoreboard players operation #<% rd %> org_jawbts_riscvmc2_register = #t org_jawbts_riscvmc2_rv32m_temp

        template _pc_add 4
    }
}

