import ./org_jawbts_riscvmc2_ascii_js.js

function load org_jawbts_riscvmc2:load {
	scoreboard objectives add org_jawbts_riscvmc2_terminal_keyboard_trigger trigger

    data modify storage org_jawbts_riscvmc2_terminal:temp buffer.in set value ""
    data modify storage org_jawbts_riscvmc2_terminal:temp buffer.terminal_render_content set value ""
    data modify storage org_jawbts_riscvmc2_terminal:temp buffer.terminal_content set value ""
    data modify storage org_jawbts_riscvmc2_terminal:temp buffer.char set value ""

    # temp purpose
    data modify storage org_jawbts_riscvmc2_terminal:temp buffer.temp set value ""

    scoreboard players set @a org_jawbts_riscvmc2_terminal_keyboard_trigger 0
}

function tick minecraft:tick {
    scoreboard players enable @a org_jawbts_riscvmc2_terminal_keyboard_trigger

    # handle keyboard input
    execute as @a run {
        execute if score @s org_jawbts_riscvmc2_terminal_keyboard_trigger matches 1.. run {
            REPEAT (1, 257) as i {
                IF i == 8 {
                    execute if score @s org_jawbts_riscvmc2_terminal_keyboard_trigger matches <%i%> run {
					    function *backspace
				    }
                } ELSE IF i == 256 {
                    execute if score @s org_jawbts_riscvmc2_terminal_keyboard_trigger matches <%i%> run {
					    function *print_keyboard_shifted
				    }
                } ELSE IF i == 257 {
                    execute if score @s org_jawbts_riscvmc2_terminal_keyboard_trigger matches <%i%> run {
					    function *print_keyboard
				    }
                } ELSE IF i == 34 {
                    execute if score @s org_jawbts_riscvmc2_terminal_keyboard_trigger matches <%i%> run {
                        tellraw @p "We can't print this char rn"
                    }
                } ELSE IF is_printable(i) {
                    execute if score @s org_jawbts_riscvmc2_terminal_keyboard_trigger matches <%i%> run {
					    function *on_key_down {key: "<% get_should_print(i) %>"}
				    }
                }
            }
        }

        scoreboard players set @s org_jawbts_riscvmc2_terminal_keyboard_trigger 0
    }

    # handle terminal content
    
    # - append riscvmc2 out
    data modify storage org_jawbts_riscvmc2_terminal:temp buffer.temp set from storage org_jawbts_riscvmc2_temp:ascii buffer.out_char
    data modify storage org_jawbts_riscvmc2_temp:ascii buffer.out_char set value ""
    block { with storage org_jawbts_riscvmc2_terminal:temp buffer
        $data modify storage org_jawbts_riscvmc2_terminal:temp buffer.terminal_content set value "$(terminal_content)$(temp)"
    }

    # - hybrid render content
    block { with storage org_jawbts_riscvmc2_terminal:temp buffer
        $data modify storage org_jawbts_riscvmc2_terminal:temp buffer.terminal_render_content set value "$(terminal_content)\n> $(in)"
    }

    # - copy to all terminals
    execute as @e[tag=riscvmc2_terminal,type=minecraft:text_display] run {
		data modify entity @s text set from storage org_jawbts_riscvmc2_terminal:temp buffer.terminal_render_content
	}
}

# args {key: "<char>"}
function on_key_down {
    $data modify storage org_jawbts_riscvmc2_terminal:temp buffer.char set value "$(key)"

    execute if data storage org_jawbts_riscvmc2_terminal:temp {buffer: {char: "\n"}} run {
        data modify storage org_jawbts_riscvmc2_terminal:temp buffer.temp set from storage org_jawbts_riscvmc2_temp:ascii buffer.in_char
        block { with storage org_jawbts_riscvmc2_terminal:temp buffer
            $data modify storage org_jawbts_riscvmc2_terminal:temp buffer.temp set value "$(temp)$(in)\n"
            $data modify storage org_jawbts_riscvmc2_terminal:temp buffer.terminal_content set value "$(terminal_content)$(in)\n"
        }
        data modify storage org_jawbts_riscvmc2_temp:ascii buffer.in_char set from storage org_jawbts_riscvmc2_terminal:temp buffer.temp

        data modify storage org_jawbts_riscvmc2_terminal:temp buffer.in set value ""
    } else run { with storage org_jawbts_riscvmc2_terminal:temp buffer
        $data modify storage org_jawbts_riscvmc2_terminal:temp buffer.in set value "$(in)$(char)"
    }
}

function backspace {
    data modify storage org_jawbts_riscvmc2_terminal:temp buffer.in set string storage org_jawbts_riscvmc2_terminal:temp buffer.in 0 -1
}

function print_keyboard {
