# Main process:
# code -- (compiler) -> RISC-V machine code -- (interpreter) -> mcf

# Register strucutre:
# #0@org_jawbts_riscvmc2_register -> x0
# #1@... -> x1
# ...
# #imm_<instruction name>@... -> template imm
# #trash_bin@... -> any write attempt to x0 should be redirected to trash_bin
# 	This step is done by the interpreter, under the prerequisite that RISC-V instructions
# 	only take input from rs and output to rd registers, and even if they are the same in original code,
#	only redirecting rd to trash_bin would still work.
# #pc@... -> the program counter register

# Storage org_jawbts_riscvmc2_temp:main inst_marco_temp is for temporary storage of values
# of marcos in case of there're deeper function calls.

# Storage org_jawbts_riscvmc2_temp:main memory is for value passing in memory.

# Storage org_jawbts_riscvmc2_temp:main inst_temp is for instructions

# Memory storage structure:
# Let x be the address which the last 2 bits are 0.
# Memory[x] = Value(x) | Value(x+1) << 8 | Value(x+2) << 16 | Value(x+3) << 24
# So for each memory address y, storage place is y & ~0b11, shift digits are 8 * (y & 0b11)
# All memory are stored in scoreboard org_jawbts_riscvmc2_memory.

# Every instrcution should make sure same register can be used for both source and destination.

# The insts listed below should have their arguments processed:
# - ADDI (imm sign extend)
# - ANDI (imm sign extend)
# - ORI (imm sign extend)
# - XORI (imm sign extend)
# - LUI (imm shift)
# - AUIPC (imm shift)
# - SLTI (imm sign extend)
# - SLTIU (imm sign extend)
# - BEQ (imm sign extend)
# - BNE (imm sign extend)
# - BGE (imm sign extend)
# - BGEU (imm sign extend)
# - BLT (imm sign extend)
# - BLTU (imm sign extend)
# - JAL (imm sign extend)
# - JALR (imm sign extend)
# - LB LH LW SB SH SW LBU LHU (imm sign extend)

# org_jawbts_riscvmc2: control signal scoreboard
# 0 means false, otherwise true
# #running: whether the cpu is running
# #read_block: whether read ecall is blocking the process

function _onload minecraft:load {
	function #org_jawbts_riscvmc2:load
}

function onload org_jawbts_riscvmc2:load {
	scoreboard objectives add org_jawbts_riscvmc2_register dummy
	scoreboard objectives add org_jawbts_riscvmc2 dummy
	scoreboard objectives add org_jawbts_riscvmc2_temp dummy

	scoreboard players set #running org_jawbts_riscvmc2 0
	scoreboard players set #ecall_block org_jawbts_riscvmc2 0

	scoreboard players set #0 org_jawbts_riscvmc2_register 0
	scoreboard players set #trash_bin org_jawbts_riscvmc2_register 0
	scoreboard players set #pc org_jawbts_riscvmc2_register 0

	REPEAT (0, 31) as i {
		scoreboard players set #<% i %> org_jawbts_riscvmc2_register 0
	}

	data modify storage org_jawbts_riscvmc2_temp:main inst_marco_temp set value {}
	data modify storage org_jawbts_riscvmc2_temp:main memory set value {}
	data modify storage org_jawbts_riscvmc2_temp:main inst_temp set value {}
}

function tick1000 {
	REPEAT (1, 1000) {
		function *tick
	}
}

function tick {
	execute unless score #running org_jawbts_riscvmc2 matches 0 if score #ecall_block org_jawbts_riscvmc2 matches 0 run {
		execute store result storage org_jawbts_riscvmc2_temp:main inst_temp.pc int 1 run scoreboard players get #pc org_jawbts_riscvmc2_register
		IF (config.textStoragePosition == "MINECRAFT_STORAGE") {
			block { with storage org_jawbts_riscvmc2_temp:main inst_temp
				$data modify storage org_jawbts_riscvmc2_temp:main inst_temp.inst set from storage org_jawbts_riscvmc2_temp:main inst.$(pc)
			}
			block { with storage org_jawbts_riscvmc2_temp:main inst_temp
				<%%
					emit(`$function ${config.instructionNamespace}:$(inst)`)
				%%>
			}
		}
		IF (config.textStoragePosition == "MINECRAFT_FUNCTION") {
			block { with storage org_jawbts_riscvmc2_temp:main inst_temp
				<%%
					emit(`$function ${config.instructionFunctionNamespace}:$(pc)`)
				%%>
			}
		}
	} else execute unless score #running org_jawbts_riscvmc2 matches 0 unless score #ecall_block org_jawbts_riscvmc2 matches 0 run {
		function org_jawbts_riscvmc2_rv32i:ecall
	}
}

function debug_tick {
	execute unless score #running org_jawbts_riscvmc2 matches 0 if score #ecall_block org_jawbts_riscvmc2 matches 0 run {
		execute store result score #t_pc org_jawbts_riscvmc2_register run data get storage riscvmc:pc_log pc[0]
		data remove storage riscvmc:pc_log pc[0]
		execute unless score #t_pc org_jawbts_riscvmc2_register = #pc org_jawbts_riscvmc2_register run {
			say PC NOT MATCH!
			scoreboard players set #running org_jawbts_riscvmc2 0
		}

		REPEAT (0, 31) as i {
			execute store result score #t_reg org_jawbts_riscvmc2_register run data get storage riscvmc:pc_log regs[0].<% i %>
			execute unless score #t_reg org_jawbts_riscvmc2_register = #<% i %> org_jawbts_riscvmc2_register run {
				say REG x<% i %> NOT MATCH!
				scoreboard players set #running org_jawbts_riscvmc2 0
			}
		}
		data remove storage riscvmc:pc_log regs[0]

		execute unless score #running org_jawbts_riscvmc2 matches 0 run {
			execute store result storage org_jawbts_riscvmc2_temp:main inst_temp.pc int 1 run scoreboard players get #pc org_jawbts_riscvmc2_register
			block { with storage org_jawbts_riscvmc2_temp:main inst_temp
				$data modify storage org_jawbts_riscvmc2_temp:main inst_temp.inst set from storage org_jawbts_riscvmc2_temp:main inst.$(pc)
			}
			block { with storage org_jawbts_riscvmc2_temp:main inst_temp
				<%%
					emit(`$function ${config.instructionNamespace}:$(inst)`)
				%%>
			}
		}

		# tellraw @a [{text: "Current PC: "}, {score: {name: "#pc", objective: "org_jawbts_riscvmc2_register"}}, {text: " , x0: "}, {score: {name: "#0", objective: "org_jawbts_riscvmc2_register"}}, {text: " , x1: "}, {score: {name: "#1", objective: "org_jawbts_riscvmc2_register"}}, {text: " , x2: "}, {score: {name: "#2", objective: "org_jawbts_riscvmc2_register"}}, {text: " , x3: "}, {score: {name: "#3", objective: "org_jawbts_riscvmc2_register"}}, {text: " , x4: "}, {score: {name: "#4", objective: "org_jawbts_riscvmc2_register"}}, {text: " , x5: "}, {score: {name: "#5", objective: "org_jawbts_riscvmc2_register"}}, {text: " , x6: "}, {score: {name: "#6", objective: "org_jawbts_riscvmc2_register"}}, {text: " , x7: "}, {score: {name: "#7", objective: "org_jawbts_riscvmc2_register"}}, {text: " , x8: "}, {score: {name: "#8", objective: "org_jawbts_riscvmc2_register"}}, {text: " , x9: "}, {score: {name: "#9", objective: "org_jawbts_riscvmc2_register"}}, {text: " , x10: "}, {score: {name: "#10", objective: "org_jawbts_riscvmc2_register"}}, {text: " , x11: "}, {score: {name: "#11", objective: "org_jawbts_riscvmc2_register"}}, {text: " , x12: "}, {score: {name: "#12", objective: "org_jawbts_riscvmc2_register"}}, {text: " , x13: "}, {score: {name: "#13", objective: "org_jawbts_riscvmc2_register"}}, {text: " , x14: "}, {score: {name: "#14", objective: "org_jawbts_riscvmc2_register"}}, {text: " , x15: "}, {score: {name: "#15", objective: "org_jawbts_riscvmc2_register"}}, {text: " , x16: "}, {score: {name: "#16", objective: "org_jawbts_riscvmc2_register"}}, {text: " , x17: "}, {score: {name: "#17", objective: "org_jawbts_riscvmc2_register"}}, {text: " , x18: "}, {score: {name: "#18", objective: "org_jawbts_riscvmc2_register"}}, {text: " , x19: "}, {score: {name: "#19", objective: "org_jawbts_riscvmc2_register"}}, {text: " , x20: "}, {score: {name: "#20", objective: "org_jawbts_riscvmc2_register"}}, {text: " , x21: "}, {score: {name: "#21", objective: "org_jawbts_riscvmc2_register"}}, {text: " , x22: "}, {score: {name: "#22", objective: "org_jawbts_riscvmc2_register"}}, {text: " , x23: "}, {score: {name: "#23", objective: "org_jawbts_riscvmc2_register"}}, {text: " , x24: "}, {score: {name: "#24", objective: "org_jawbts_riscvmc2_register"}}, {text: " , x25: "}, {score: {name: "#25", objective: "org_jawbts_riscvmc2_register"}}, {text: " , x26: "}, {score: {name: "#26", objective: "org_jawbts_riscvmc2_register"}}, {text: " , x27: "}, {score: {name: "#27", objective: "org_jawbts_riscvmc2_register"}}, {text: " , x28: "}, {score: {name: "#28", objective: "org_jawbts_riscvmc2_register"}}, {text: " , x29: "}, {score: {name: "#29", objective: "org_jawbts_riscvmc2_register"}}, {text: " , x30: "}, {score: {name: "#30", objective: "org_jawbts_riscvmc2_register"}}, {text: " , x31: "}, {score: {name: "#31", objective: "org_jawbts_riscvmc2_register"}}]
	} else execute unless score #running org_jawbts_riscvmc2 matches 0 unless score #ecall_block org_jawbts_riscvmc2 matches 0 run {
		function org_jawbts_riscvmc2_rv32i:ecall
	}
}

function reload {
	function #org_jawbts_riscvmc2:load

	scoreboard players set #running org_jawbts_riscvmc2 0
	scoreboard players set #ecall_block org_jawbts_riscvmc2 0

	data modify storage org_jawbts_riscvmc2_temp:main inst set value {}
	scoreboard objectives remove org_jawbts_riscvmc2_memory
	scoreboard objectives add org_jawbts_riscvmc2_memory dummy
	scoreboard players set #pc org_jawbts_riscvmc2_register 0

	function org_jawbts_riscvmc2_loader:all
}